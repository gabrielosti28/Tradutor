<Window x:Class="Tradutor.WindowsAntigoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tradutor do Computador"
        Height="540" Width="620"
        WindowStartupLocation="CenterScreen"
        Background="#F0F4F8"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="#1E3A5F">
            <StackPanel VerticalAlignment="Center" Margin="25,0">
                <TextBlock Text="💻 Tradutor do Computador"
                           FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Seu computador precisa de atenção antes de continuar"
                           FontSize="11" Foreground="#A8C4E0"/>
            </StackPanel>
        </Border>

        <!-- Conteúdo -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,25">

                <!-- Ícone e título -->
                <TextBlock Text="⚠️"
                           FontSize="48"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Olá! Notamos que o seu Windows é antigo."
                           FontSize="18" FontWeight="Bold"
                           Foreground="#1E3A5F"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,15"/>

                <!-- Explicação humana -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#444"
                                   LineHeight="22">
                            O <Bold>Tradutor do Computador</Bold> foi feito para funcionar 
                            no <Bold>Windows 10</Bold> ou no <Bold>Windows 11</Bold> — 
                            as versões mais recentes e seguras do Windows.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#444"
                                   LineHeight="22" Margin="0,10,0,0">
                            O seu computador está usando uma versão mais antiga. 
                            Isso não é culpa sua — muitos computadores vêm assim de fábrica 
                            ou simplesmente nunca foram atualizados.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#444"
                                   LineHeight="22" Margin="0,10,0,0">
                            Usar um Windows antigo pode deixar o seu computador 
                            <Bold>mais lento, mais vulnerável a vírus</Bold> e sem acesso 
                            a recursos novos. A boa notícia é que a atualização 
                            é <Bold>gratuita!</Bold>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Opções -->
                <TextBlock Text="O que você gostaria de fazer?"
                           FontSize="14" FontWeight="Bold"
                           Foreground="#1E3A5F"
                           Margin="0,5,0,12"/>

                <!-- Botão: Atualizar para Windows 10 -->
                <Border Background="White" CornerRadius="10" Padding="15"
                        Margin="0,0,0,10" Cursor="Hand"
                        MouseLeftButtonUp="AtualizarWindows10_Click">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.1"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⬆️" FontSize="28"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Atualizar para o Windows 10 (gratuito)"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="#1E3A5F"/>
                            <TextBlock Text="Vou te levar ao site oficial da Microsoft para baixar a atualização com segurança."
                                       FontSize="11" Foreground="#666"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Botão: Atualizar para Windows 11 -->
                <Border Background="White" CornerRadius="10" Padding="15"
                        Margin="0,0,0,10" Cursor="Hand"
                        MouseLeftButtonUp="AtualizarWindows11_Click">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.1"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🚀" FontSize="28"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Atualizar para o Windows 11 (gratuito)"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="#1E3A5F"/>
                            <TextBlock Text="A versão mais moderna do Windows. Vou te levar ao site oficial da Microsoft."
                                       FontSize="11" Foreground="#666"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Botão: Verificar compatibilidade -->
                <Border Background="White" CornerRadius="10" Padding="15"
                        Margin="0,0,0,10" Cursor="Hand"
                        MouseLeftButtonUp="VerificarCompatibilidade_Click">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.1"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="28"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Verificar se meu computador aceita o Windows 11"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="#1E3A5F"/>
                            <TextBlock Text="Nem todo computador aceita o Windows 11. Clique aqui para descobrir se o seu aceita antes de tentar atualizar."
                                       FontSize="11" Foreground="#666"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Rodapé -->
        <Border Grid.Row="2" Background="#162D4A">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Precisa de ajuda? Peça a alguém de confiança para te auxiliar nessa atualização."
                           Foreground="#A8C4E0" FontSize="11"
                           TextAlignment="Center"/>
                <TextBlock x:Name="LblVersaoAtual"
                           Foreground="#6B8CAE" FontSize="10"
                           TextAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>