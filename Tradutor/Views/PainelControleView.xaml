<UserControl x:Class="Tradutor.Views.PainelControleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">

            <TextBlock Text="🏠 Painel de Controle Simplificado"
                       FontSize="22" FontWeight="Bold"
                       Foreground="#1E3A5F" Margin="0,0,0,5"/>
            <TextBlock Text="Aqui você encontra as configurações mais importantes do seu computador, explicadas de forma simples."
                       FontSize="13" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,20"/>

            <!-- Grade de Cartões -->
            <WrapPanel>

                <!-- Cartão: Nome do Computador -->
                <Border Style="{StaticResource CardStyle}" Tag="NomePC">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{x:Null}"/>
                    </Border.InputBindings>
                    <StackPanel>
                        <TextBlock Text="🖥️" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="Nome do Computador"
                                   FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="#1E3A5F" Margin="0,8,0,4"/>
                        <TextBlock Text="Veja e altere como seu computador é identificado na rede"
                                   FontSize="11" Foreground="#666"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                        <Button Content="Abrir" Margin="0,12,0,0"
                                Style="{StaticResource CardButtonStyle}"
                                Click="AbrirNomePC_Click"/>
                    </StackPanel>
                </Border>

                <!-- Cartão: Desempenho -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="⚡" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="Peças da máquina"
                                   FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="#1E3A5F" Margin="0,8,0,4"/>
                        <TextBlock Text="Veja algumas das peça de sua máquina"
                                   FontSize="11" Foreground="#666"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                        <Button Content="Abrir" Margin="0,12,0,0"
                                Style="{StaticResource CardButtonStyle}"
                                Click="AbrirDesempenho_Click"/>
                    </StackPanel>
                </Border>

                <!-- Cartão: Data e Hora -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="🕐" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="Data e Hora"
                                   FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="#1E3A5F" Margin="0,8,0,4"/>
                        <TextBlock Text="Ajuste a data, hora e fuso horário do seu computador"
                                   FontSize="11" Foreground="#666"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                        <Button Content="Abrir" Margin="0,12,0,0"
                                Style="{StaticResource CardButtonStyle}"
                                Click="AbrirDataHora_Click"/>
                    </StackPanel>
                </Border>

                <!-- Cartão: Programas Instalados -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="📦" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="Programas Instalados"
                                   FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="#1E3A5F" Margin="0,8,0,4"/>
                        <TextBlock Text="Veja o que está instalado e remova o que não usa mais"
                                   FontSize="11" Foreground="#666"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                        <Button Content="Abrir" Margin="0,12,0,0"
                                Style="{StaticResource CardButtonStyle}"
                                Click="AbrirProgramas_Click"/>
                    </StackPanel>
                </Border>

                <!-- Cartão: Windows Update -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="🔄" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="Atualizações"
                                   FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="#1E3A5F" Margin="0,8,0,4"/>
                        <TextBlock Text="Mantenha seu Windows sempre seguro e atualizado"
                                   FontSize="11" Foreground="#666"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                        <Button Content="Abrir" Margin="0,12,0,0"
                                Style="{StaticResource CardButtonStyle}"
                                Click="AbrirAtualizacoes_Click"/>
                    </StackPanel>
                </Border>

                <!-- Cartão: Rede e Internet -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="🌐" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="Rede e Internet"
                                   FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="#1E3A5F" Margin="0,8,0,4"/>
                        <TextBlock Text="Veja sua conexão Wi-Fi ou cabo e resolva problemas de internet"
                                   FontSize="11" Foreground="#666"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                        <Button Content="Abrir" Margin="0,12,0,0"
                                Style="{StaticResource CardButtonStyle}"
                                Click="AbrirRede_Click"/>
                    </StackPanel>
                </Border>

            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>