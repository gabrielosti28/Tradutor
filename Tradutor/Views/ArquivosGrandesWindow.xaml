<Window x:Class="Tradutor.Views.ArquivosGrandesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔎 Arquivos que Ocupam Mais Espaço"
        Height="580" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#F0F4F8"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="#1E3A5F">
            <StackPanel VerticalAlignment="Center" Margin="25,0">
                <TextBlock Text="🔎 Arquivos que Ocupam Mais Espaço"
                           FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Encontre o que está enchendo seu computador"
                           FontSize="11" Foreground="#A8C4E0"/>
            </StackPanel>
        </Border>

        <!-- Barra de status -->
        <Border Grid.Row="1" Background="#E8F0F8" Padding="15,10">
            <StackPanel>
                <TextBlock x:Name="LblStatus"
                           Text="Clique em 'Procurar' para começar a busca."
                           FontSize="12" Foreground="#1E3A5F"/>
                <ProgressBar x:Name="BarraProgresso"
                             Height="6" Margin="0,6,0,0"
                             IsIndeterminate="False"
                             Visibility="Collapsed"
                             Background="#DDD"
                             Foreground="#1E3A5F"/>
            </StackPanel>
        </Border>

        <!-- Lista de arquivos -->
        <Border Grid.Row="2" Margin="15,10,15,0">
            <ListView x:Name="ListaArquivos"
                      Background="White"
                      BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Tipo" Width="40"
                                        DisplayMemberBinding="{Binding Icone}"/>
                        <GridViewColumn Header="Nome do Arquivo" Width="280"
                                        DisplayMemberBinding="{Binding Nome}"/>
                        <GridViewColumn Header="Tamanho" Width="90"
                                        DisplayMemberBinding="{Binding Tamanho}"/>
                        <GridViewColumn Header="Pasta" Width="230"
                                        DisplayMemberBinding="{Binding Pasta}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Rodapé com botões -->
        <Border Grid.Row="3" Background="White" Padding="15,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="-2" Opacity="0.08"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="🔍  Procurar Agora" Width="160" Height="38"
                        Style="{StaticResource CardButtonStyle}"
                        Click="ProcurarArquivos_Click" Margin="0,0,10,0"/>
                <Button Content="📂  Abrir Arquivo Selecionado" Width="210" Height="38"
                        Style="{StaticResource CardButtonStyle}"
                        Click="AbrirArquivo_Click" Margin="0,0,10,0"/>
                <Button Content="🗑️  Apagar Selecionado" Width="180" Height="38"
                        Style="{StaticResource CardButtonStyle}"
                        Click="ApagarArquivo_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>